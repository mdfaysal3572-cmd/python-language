#sorted() with dictionary
students = [
    {"name": "Foysal", "marks": 69}, 
    {"name": "Rana", "marks": 80}, 
    {"name": "Sakib", "marks": 90}, 
    {"name": "Forhad", "marks": 95}, 
    {"name": "Shakil", "marks": 70}, 
    {"name": "Rasel", "marks": 50}
]
result = sorted(students, key = lambda students: students["marks"])
print(result)
result1 = list(filter(lambda students: students["marks"] > 50, students))
print(result1)
for students in result1:
    print(f"name: {students["name"]}, marks: {students["marks"]}")

