
n = int(input("Enter a number:"))
if(n<2):
    print("the number is not prime")
else:
    is_prime = True
    for i in range (2, n + 1):
        if n % i == 0:
            is_prime = False
            break
    if is_prime:
        print("The number is prime number:")
    else:
        print("the number is not prime")

